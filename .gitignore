# ─────────────────────────────────────────────────────────────────────────────
# DOS Capsule — combined .gitignore
# Sections: secrets · OS/editor · Go · Node/TypeScript · build output · project
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets (never commit) ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editors / IDEs ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
*~
.#*
\#*\#
.project
.settings/

# ── Go ───────────────────────────────────────────────────────────────────────
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binary / coverage / profiles
*.test
*.out
coverage.html
coverage.txt
coverage.xml
*.coverprofile
profile.cov
# Dependency dirs
/vendor/
# Workspace
go.work
go.work.sum

# ── Node / TypeScript / JavaScript ───────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
.pnp.cjs
.pnp.loader.mjs
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache
# JS frameworks build dirs (excluding the embedded one below, handled later)
# (dist/ at repo root is ignored further down)

# ── Build output: frontend (embedded via go:embed) ───────────────────────────
cmd/doscapsule/dist/
/dist/

# ── Build output: binaries (ROOT-ANCHORED) ───────────────────────────────────
# A bare `doscapsule` would also match the source dir cmd/doscapsule/ and
# silently drop every .go file — keep these anchored to the repo root.
/doscapsule
/doscapsule-arm64
/doscapsule-amd64
/dosgame-launcher
/dosgame-launcher-*
*.zip
*.tar.gz
*.tgz

# ── Project runtime state (portable mode) ────────────────────────────────────
/data/

# ── DOSBox bundle (users install it themselves) ──────────────────────────────
/binaries/

# ── Temp / misc ──────────────────────────────────────────────────────────────
*.log
!docs/**/*.log
tmp/
temp/
.cache/
